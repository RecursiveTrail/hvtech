---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { site } from '../content';
---
<BaseLayout title={`${site.about.eyebrow} — HV Technologies`} description={site.about.paragraphs[0]}>
  <Header />
  <main id="main">
    <Section eyebrow={site.about.eyebrow} title={site.about.title}>
      <div class="grid items-center gap-10 md:grid-cols-2">
        <img
          src={site.about.photo}
          alt={site.about.photoAlt}
          class="w-full rounded-sm object-cover"
        />
        <div>
          {site.about.paragraphs.map((paragraph) => (
            <p class="mt-4 text-sm leading-relaxed text-mute first:mt-0">{paragraph}</p>
          ))}
        </div>
      </div>
    </Section>
    <CtaBand />
  </main>
  <Footer />
  <WhatsApp />
</BaseLayout>
