---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Section from '../components/ui/Section.astro';
import ContactForm from '../components/ContactForm.astro';
import { contact } from '../content';
import { withBase } from '../lib/with-base';

const person = contact.person;
---
<BaseLayout title={contact.seoTitle} description={contact.seoDescription}>
  <Header />
  <main id="main">
    <section class="bg-paper py-16 md:py-20">
      <div class="mx-auto grid max-w-6xl items-start gap-10 px-4 md:grid-cols-2">
        <div>
          <img
            src={withBase(contact.image)}
            alt={contact.imageAlt}
            class="w-full rounded-sm object-cover"
          />
          <article class="mt-6 rounded-sm border border-line bg-white p-6">
            <div class="flex items-center gap-4">
              <div class="flex size-14 shrink-0 items-center justify-center rounded-sm bg-ink text-lg font-extrabold text-white" aria-hidden="true">
                {person.initials}
              </div>
              <div>
                <p class="font-bold">{person.name}</p>
                <a href={person.phoneHref} class="mt-1 inline-block text-sm font-semibold text-accent hover:text-accent-hover">
                  {person.phone}
                </a>
              </div>
            </div>
          </article>
        </div>

        <div>
          <p class="border-l-4 border-accent pl-3 text-xs font-bold uppercase tracking-widest text-accent">
            {contact.eyebrow}
          </p>
          <h1 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">{contact.title}</h1>
          <div class="mt-8">
            <ContactForm />
          </div>
        </div>
      </div>
    </section>

    <Section eyebrow={contact.mapEyebrow} title={contact.mapTitle}>
      <iframe
        src={contact.mapEmbed}
        title={contact.mapIframeTitle}
        class="h-80 w-full rounded-sm border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </Section>
  </main>
  <Footer />
  <WhatsApp />
</BaseLayout>
