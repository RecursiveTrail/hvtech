---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsApp from '../../components/WhatsApp.astro';
import { getProduct, products, site } from '../../content';
import { withBase } from '../../lib/with-base';

export function getStaticPaths() {
  return products.items.map((item) => ({ params: { slug: item.slug } }));
}

const product = getProduct(Astro.params.slug!);
if (!product) {
  throw new Error(`Unknown product ${Astro.params.slug}`);
}

const specs = product.specs as { label: string; value: string }[];
---
<BaseLayout title={`${product.name} — ${site.brand.name}`} description={product.summary}>
  <Header />
  <main id="main" class="bg-paper">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
      <a href={withBase('/products')} class="text-sm font-semibold text-accent hover:text-accent-hover">
        {products.page.backLabel}
      </a>

      <div class="mt-8 grid items-start gap-10 md:grid-cols-2">
        {product.image ? (
          <img
            src={withBase(product.image)}
            alt={product.name}
            class="aspect-[4/3] w-full rounded-sm object-cover"
          />
        ) : (
          <div class="flex aspect-[4/3] w-full items-center justify-center rounded-sm bg-ink px-4 text-center text-lg font-semibold text-white">
            {product.name}
          </div>
        )}

        <div>
          <h1 class="text-3xl font-extrabold tracking-tight md:text-4xl">{product.name}</h1>
          <p class="mt-4 text-base leading-relaxed text-mute">{product.summary}</p>
          <p class="mt-6 text-sm leading-relaxed text-mute">{product.description}</p>

          {product.standards.length > 0 && (
            <div class="mt-8">
              <h2 class="text-sm font-bold uppercase tracking-widest text-ink">{products.page.standardsHeading}</h2>
              <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-mute">
                {product.standards.map((standard) => (
                  <li>{standard}</li>
                ))}
              </ul>
            </div>
          )}

          {specs.length > 0 && (
            <div class="mt-8">
              <h2 class="text-sm font-bold uppercase tracking-widest text-ink">{products.page.specsHeading}</h2>
              <table class="mt-3 w-full border-collapse text-sm">
                <tbody>
                  {specs.map((spec) => (
                    <tr class="border-b border-line">
                      <th class="py-2 pr-4 text-left font-semibold text-ink">{spec.label}</th>
                      <td class="py-2 text-mute">{spec.value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          <a
            href={withBase(`/contact-us?interest=${product.slug}`)}
            class="mt-8 inline-block rounded-sm bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-accent-hover"
          >
            {products.page.enquireLabel}
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <WhatsApp />
</BaseLayout>
