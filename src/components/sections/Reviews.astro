---
import Section from '../ui/Section.astro';
import { reviews } from '../../content';
---
<Section eyebrow={reviews.eyebrow} title={reviews.title}>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {reviews.items.map((review) => (
      <article class="rounded-sm border border-line bg-white p-6">
        <p class="text-sm text-accent" role="img" aria-label={`${review.stars} out of 5 stars`}>
          {'★'.repeat(review.stars)}{'☆'.repeat(5 - review.stars)}
        </p>
        <p class="mt-3 text-sm leading-relaxed text-mute">“{review.quote}”</p>
        <div class="mt-4 flex items-center gap-3">
          <img
            src={review.image}
            alt=""
            width="40"
            height="40"
            loading="lazy"
            class="size-10 rounded-sm object-cover"
          />
          <p class="text-sm font-semibold">{review.name}</p>
        </div>
      </article>
    ))}
  </div>
</Section>
