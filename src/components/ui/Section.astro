---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  tone?: 'light' | 'dark';
}

const { id, eyebrow, title, tone = 'light' } = Astro.props;
const isDark = tone === 'dark';
---
<section
  id={id}
  class:list={[
    'py-16 md:py-20',
    isDark ? 'bg-ink text-white' : 'bg-paper text-ink',
  ]}
>
  <div class="mx-auto max-w-6xl px-4">
    <p class="border-l-4 border-accent pl-3 text-xs font-bold uppercase tracking-widest text-accent">
      {eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight md:text-4xl">{title}</h2>
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
